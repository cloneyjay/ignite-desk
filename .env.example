# ---------------------------------------------------------------------------
# Ignite Desk - local configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# MT5 MCP servers (remote Streamable HTTP, already running with the terminal)
MT5_MCP_URL=http://127.0.0.1:22346/mcp
MT5_MCP_EDITOR_URL=http://127.0.0.1:22345/mcp
MT5_MCP_TOKEN=

# LLM providers (all OpenAI-compatible). Order = fallback chain.
LLM_PROVIDER_ORDER=nim,local
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b

# Optional extra OpenAI-compatible endpoint (e.g. opencode Zen)
EXTRA_BASE_URL=
EXTRA_API_KEY=
EXTRA_MODEL=

# Runtime
IGNITE_TZ=local
IGNITE_DB_PATH=./data/ignite.db
IGNITE_BIND_HOST=127.0.0.1
IGNITE_BIND_PORT=8000
IGNITE_DRAFT_TTL_S=90
IGNITE_MAX_DRIFT_ATR=0.30
KRONOS_WORKER_URL=http://127.0.0.1:8765
KRONOS_MODEL=NeoQuasar/Kronos-mini
